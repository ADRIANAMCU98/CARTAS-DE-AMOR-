rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Letter Validation
    function isValidLetter(data) {
      return data.userId == request.auth.uid
        && data.recipientName is string && data.recipientName.size() <= 100
        && data.context is string && data.context.size() <= 1000
        && data.style is string && data.style.size() <= 100
        && data.content is string && data.content.size() <= 10000;
    }

    match /letters/{letterId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(letterId)
        && isValidLetter(incoming());
        
      allow update: if isSignedIn()
        && isOwner(existing().userId)
        && isValidLetter(incoming())
        && incoming().userId == existing().userId;

      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
